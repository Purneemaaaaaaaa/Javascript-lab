// Program to find larger and smaller of two integers

const readline = require("readline");

const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
});

rl.question("Enter first integer: ", function(num1) {
    rl.question("Enter second integer: ", function(num2) {

        num1 = Number(num1);
        num2 = Number(num2);

        if (num1 > num2) {
            console.log("Larger:", num1);
            console.log("Smaller:", num2);
        } else if (num2 > num1) {
            console.log("Larger:", num2);
            console.log("Smaller:", num1);
        } else {
            console.log("Both numbers are equal.");
        }

        rl.close();
    });
});