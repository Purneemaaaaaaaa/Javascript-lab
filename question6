// Program to calculate number of days left until next Christmas

let today = new Date();
let christmas = new Date(today.getFullYear(), 11, 25);

// If Christmas has already passed, use next year's Christmas
if (today > christmas) {
    christmas = new Date(today.getFullYear() + 1, 11, 25);
}

let difference = christmas - today;
let daysLeft = Math.ceil(difference / (1000 * 60 * 60 * 24));

console.log("Days left until Christmas:", daysLeft);