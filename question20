// Program to find time difference in days between two dates

function getTimeDifference(date1, date2) {
    var d1 = new Date(date1);
    var d2 = new Date(date2);

    var difference = Math.abs(d2 - d1);

    var days = difference / (1000 * 60 * 60 * 24);

    return days;
}

var date1 = "2026-08-01";
var date2 = "2026-08-30";

console.log("First Date:", date1);
console.log("Second Date:", date2);
console.log("Time difference in days:", getTimeDifference(date1, date2));