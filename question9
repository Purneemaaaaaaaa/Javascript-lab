// Program to find larger and smaller of three integers

const readline = require("readline");

const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
});

rl.question("Enter first integer: ", function(num1) {
    rl.question("Enter second integer: ", function(num2) {
        rl.question("Enter third integer: ", function(num3) {

            num1 = Number(num1);
            num2 = Number(num2);
            num3 = Number(num3);

            let largest = Math.max(num1, num2, num3);
            let smallest = Math.min(num1, num2, num3);

            console.log("Larger:", largest);
            console.log("Smaller:", smallest);

            rl.close();
        });
    });
});